{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.songdocent.desktop",
  "app": {
    "windows": [
      {
        "title": "SongDocent",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "transparent": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 21, "y": 30 },
        "acceptFirstMouse": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
