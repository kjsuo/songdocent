{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "os:allow-platform",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "spotify:"
        },
        {
          "url": "music://"
        },
        {
          "url": "https://open.spotify.com/"
        },
        {
          "url": "https://music.apple.com/"
        },
        {
          "url": "https://ai.google.dev/gemini-api/docs/api-key"
        },
        {
          "url": "https://aistudio.google.com/apikey"
        },
        {
          "url": "https://platform.openai.com/api-keys"
        },
        {
          "url": "https://platform.claude.com/settings/keys"
        },
        {
          "url": "https://platform.claude.com/docs/en/manage-claude/authentication"
        },
        {
          "url": "https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key"
        },
        {
          "url": "https://developers.openai.com/codex/cli/"
        },
        {
          "url": "https://developers.openai.com/codex/auth/"
        },
        {
          "url": "https://code.claude.com/docs/en/setup"
        },
        {
          "url": "https://code.claude.com/docs/en/authentication"
        },
        {
          "url": "https://geminicli.com/docs/get-started/installation/"
        },
        {
          "url": "https://geminicli.com/docs/get-started/authentication/"
        },
        {
          "url": "https://antigravity.google/docs/cli/install/"
        },
        {
          "url": "https://antigravity.google/docs/install/"
        },
        {
          "url": "https://opencode.ai/docs/"
        },
        {
          "url": "https://opencode.ai/docs/providers/"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
