{
  "name": "songdocent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "pnpm run test:i18n && pnpm run test:translation-languages && pnpm run test:lyrics-view && pnpm run test:lyric-selection && pnpm run test:translation-action && pnpm run test:playback-state && pnpm run test:desktop-polling && pnpm run test:cli-ai && pnpm run test:settings && pnpm run test:settings-component && pnpm run test:app-error && pnpm run test:platform && pnpm run test:setup && pnpm run test:setup-component && pnpm run test:guide-links && pnpm run test:provider-connection && pnpm run test:waiting-for-music && pnpm run test:updates && pnpm run test:release && pnpm run test:text-breaks",
    "test:translation-languages": "vitest run src/translationLanguages.test.ts src/TranslationLanguageSelect.component.test.tsx",
    "test:lyrics-view": "node --experimental-strip-types src/lyricsView.node.test.ts",
    "test:lyric-selection": "node --experimental-strip-types src/lyricSelection.node.test.ts",
    "test:translation-action": "node --experimental-strip-types src/translationAction.node.test.ts",
    "test:playback-state": "node --experimental-strip-types src/playbackState.node.test.ts",
    "test:desktop-polling": "vitest run src/useDesktopPolling.component.test.tsx",
    "test:settings": "node --experimental-strip-types src/settings.node.test.ts",
    "test:settings-component": "vitest run src/SettingsModal.component.test.tsx src/useCloudModels.component.test.tsx src/lyricSelection.component.test.tsx",
    "test:app-error": "node --experimental-strip-types src/appError.node.test.ts",
    "test:platform": "node --experimental-strip-types src/platform/platformCopy.node.test.ts && node --experimental-strip-types src/platform/runtimePlatform.node.test.ts",
    "test:setup": "node --experimental-strip-types src/setup/setupState.node.test.ts && node --experimental-strip-types src/setup/SetupWizard.styles.node.test.ts",
    "test:setup-component": "vitest run src/setup/SetupWizard.component.test.tsx src/setup/KeychainPrimer.component.test.tsx",
    "test:guide-links": "node --experimental-strip-types src/setup/guideLinks.node.test.ts && vitest run src/setup/SetupGuide.component.test.tsx",
    "test:provider-connection": "node --experimental-strip-types src/providerConnection.node.test.ts && vitest run src/ProviderConnectionRiskModal.component.test.tsx src/useProviderConnection.component.test.tsx",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:waiting-for-music": "vitest run src/WaitingForMusic.component.test.tsx",
    "release:check": "node scripts/release.mjs check",
    "release:version": "node scripts/release.mjs set-version",
    "release:prepare": "node scripts/release.mjs prepare",
    "test:updates": "vitest run src/appUpdates.component.test.tsx",
    "test:release": "node --test scripts/release.test.mjs",
    "test:cli-ai": "vitest run src/ai/AiConnectionPanel.component.test.tsx",
    "test:i18n": "vitest run src/localization.component.test.tsx src/settingsCopy.test.ts",
    "check:public": "node scripts/public-check.mjs",
    "test:text-breaks": "vitest run src/textBreaks.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "budoux": "0.9.3",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kjsuo/songdocent.git"
  },
  "license": "MIT"
}
